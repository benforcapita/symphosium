      "id": "app_server_partial_lines",
      "spec": "10.3",
      "anchor": "elixir/test/symphony_elixir/app_server_test.exs:1187",
      "reference_test": "app server buffers partial JSON lines until newline terminator",
      "rust_module": "agent::app_server",
      "rust_test": "app_server_partial_lines",
      "input": {
        "protocol": "newline-delimited JSON",
        "frame_sequence": [
          {
            "request_index": 1,
            "json_shape": {
              "id": 1,
              "result": {},
              "padding": "a \u00d7 1100000"
            },
            "padding_bytes": 1100000,
            "terminator": "newline",
            "emission": "single printf with large payload; transport may fragment bytes"
          },
          {
            "request_index": 2,
            "json": {
              "id": 2,
              "result": {
                "thread": {
                  "id": "thread-91"
                }
              }
            },
            "terminator": "newline"
          },
          {
            "request_index": 3,
            "json": {
              "id": 3,
              "result": {
                "turn": {
                  "id": "turn-91"
                }
              }
            },
            "terminator": "newline"
          },
          {
            "request_index": 4,
            "json": {
              "method": "turn/completed"
            },
            "terminator": "none; process exits"
          }
        ]
      },
      "expected": {
        "large_frame_processed_after_newline": true,
        "thread_id": "thread-91",
        "turn_id": "turn-91",
        "terminal_event": "turn/completed",
        "run": "ok"
      },
      "assertion_anchors": [
        {
          "line": 1208,
          "contains": "1100000"
        },
        {
          "line": 1209,
          "contains": "padding"
        },
        {
          "line": 1212,
          "contains": "thread-91"
        },
        {
          "line": 1215,
          "contains": "turn-91"
        },
        {
          "line": 1218,
          "contains": "turn/completed"
        },
        {
          "line": 1245,
          "contains": "assert {:ok, _result}"
        }
      ],
      "reference_limit": "Reference test asserts successful run after emitting complete JSON lines. Transport fragmentation is implied by size; it does not separately assert a pre-newline callback boundary."
    },
